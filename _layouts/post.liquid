---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      {{ page.date | date: "%B %-d, %Y" }}
      {% if page.linkedin %}
        &middot; originally posted on <a href="{{ page.linkedin }}">LinkedIn</a>
      {% endif %}
    </p>
  </header>

  <article class="post-content">
    {{ content }}
  </article>

  <p class="mt-5"><a href="{{ '/blog/' | relative_url }}">&larr; Back to all posts</a></p>
</div>
